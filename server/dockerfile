FROM node:22

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for better Docker layer caching
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies with verbose logging and faster npm ci
RUN npm ci --verbose --no-audit --no-fund

# Copy rest of the application
COPY . .

ARG API_DB_URL
ENV DATABASE_URL=$API_DB_URL

ENTRYPOINT ["sh", "-c"]

CMD ["npm start"]