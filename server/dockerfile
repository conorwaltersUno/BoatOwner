FROM node:22

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for better Docker layer caching
COPY package*.json ./
COPY tsconfig.json ./

# Set npm configurations for faster, more reliable installs
RUN npm config set fetch-timeout 60000 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm config set fetch-retry-maxtimeout 60000 && \
    npm config set fetch-retries 3 && \
    npm config set audit false && \
    npm config set fund false

# Install dependencies with verbose logging and faster npm ci
# Add explicit memory limit and network timeout handling
RUN echo "Starting npm ci installation..." && \
    npm ci --verbose --no-audit --no-fund --maxsockets 1 || \
    (echo "npm ci failed, trying with legacy-peer-deps..." && \
     npm ci --verbose --no-audit --no-fund --legacy-peer-deps --maxsockets 1) || \
    (echo "npm ci still failed, trying npm install..." && \
     npm install --verbose --no-audit --no-fund --maxsockets 1)

# Copy rest of the application
COPY . .

ARG API_DB_URL
ENV DATABASE_URL=$API_DB_URL

ENTRYPOINT ["sh", "-c"]

CMD ["npm start"]