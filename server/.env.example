# .env.example for BoatOwner Backend
# Copy to .env.local, .env.dev, .env.staging, or .env.prod and fill in real values

# Database Configuration
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>?schema=public

# Individual Database Components (for easier management)
DB_HOST=<database_host>
DB_PORT=5432
DB_NAME=<database_name>
DB_USER=<database_user>
DB_PASSWORD=<database_password>

# JWT Secrets (REQUIRED - Generate secure random strings)
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Environment Configuration
NODE_ENV=development
# NODE_ENV=staging
# NODE_ENV=production

# Server Configuration
PORT=3001

# AWS SSO Configuration (Optional)
# AWS_SSO_INSTANCE_ARN=your_sso_instance_arn
# AWS_SSO_CLIENT_ID=your_oidc_client_id
# AWS_SSO_REGION=us-east-1
# AWS_SSO_DOMAIN=your_sso_domain
# USE_AWS_SSO=true

# Add any other API keys (e.g., Google Maps, S3, etc.)
# GOOGLE_MAPS_API_KEY=your_google_maps_key
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
