name: Deploy API to Staging

on:
  push:
    branches:
      - staging
    paths:
      - "server/**"

defaults:
  run:
    shell: bash

jobs:
  deploy:
    runs-on: self-hosted
    steps:
      - name: 🛎 Checkout
        uses: actions/checkout@v2

      - name: Build Docker image
        working-directory: ./server
        run: |
          docker build --build-arg API_DB_URL="${{ secrets.STAGING_DB_URL }}" -t boatowner-api:latest .

      - name: Save Docker image to tar
        working-directory: ./server
        run: |
          docker save boatowner-api:latest -o boatowner-api.tar

      - name: Copy Docker image to EC2 (staging)
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.STAGING_EC2_HOST }}
          username: ${{ secrets.STAGING_EC2_USER }}
          key: ${{ secrets.STAGING_EC2_SSH_KEY }}
          script: |
            # Remove old tar file if it exists
            rm -f ~/boatowner-api.tar

      - name: Upload Docker image via SCP
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.STAGING_EC2_HOST }}
          username: ${{ secrets.STAGING_EC2_USER }}
          key: ${{ secrets.STAGING_EC2_SSH_KEY }}
          source: "server/boatowner-api.tar"
          target: "~/"
          overwrite: true

      - name: Upload environment file via SCP
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.STAGING_EC2_HOST }}
          username: ${{ secrets.STAGING_EC2_USER }}
          key: ${{ secrets.STAGING_EC2_SSH_KEY }}
          source: "server/.env.staging"
          target: "~/BoatOwner/server/"
          overwrite: true

      - name: Upload docker-compose file via SCP
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.STAGING_EC2_HOST }}
          username: ${{ secrets.STAGING_EC2_USER }}
          key: ${{ secrets.STAGING_EC2_SSH_KEY }}
          source: "docker-compose.staging.yml"
          target: "~/BoatOwner/"
          overwrite: true
          
      - name: Deploy and run Docker Compose on EC2 (staging)
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.STAGING_EC2_HOST }}
          username: ${{ secrets.STAGING_EC2_USER }}
          key: ${{ secrets.STAGING_EC2_SSH_KEY }}
          script: |
            # Create directory structure if it doesn't exist
            mkdir -p ~/BoatOwner/server
            
            # Load Docker image
            docker load -i ~/boatowner-api.tar
            
            # Navigate to BoatOwner directory
            cd ~/BoatOwner
            
            # Debug: List files to verify they exist and are files (not directories)
            echo "=== Checking file structure ==="
            echo "Files in ~/BoatOwner:"
            ls -la
            echo "Type of docker-compose.staging.yml:"
            file docker-compose.staging.yml
            echo "Files in ~/BoatOwner/server:"
            ls -la server/
            echo "Type of .env.staging file:"
            file server/.env.staging
            
            # Start services with Docker Compose using STAGING environment
            echo "=== Starting Docker Compose for STAGING ==="
            docker-compose -f docker-compose.staging.yml up -d || docker compose -f docker-compose.staging.yml up -d
            
            # Show running containers
            echo "=== Running containers ==="
            docker ps
            
            # Clean up old Docker images
            echo "=== Cleaning up old images ==="
            docker image prune -f

      - name: Notify Success
        run: echo "Backend deployed to STAGING EC2 successfully!"
